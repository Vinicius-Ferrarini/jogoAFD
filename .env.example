# Configuração opcional do Firebase (login anônimo + telemetria de pesquisa).
#
# NÃO é necessária para rodar o jogo localmente — sem essas variáveis o app
# roda em modo degradado (sem login/salvamento em nuvem, só localStorage).
#
# Para habilitar: crie um projeto no console do Firebase (gratuito), ative
# Authentication (método Anônimo) e Firestore, copie este arquivo para
# .env.local e preencha com as chaves do SEU projeto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
